<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.mindbase.sync</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/mindbase-sync</string>
        <string>watch</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin</string>
        <key>MINDBASE_API_URL</key>
        <string>http://localhost:8080</string>
        <key>MINDBASE_API_KEY</key>
        <string>change-me-to-a-long-random-secret</string>
        <key>OBSIDIAN_VAULT_PATH</key>
        <string>/Users/YOU/Documents/MyVault</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/tmp/mindbase-sync.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/mindbase-sync.err</string>
</dict>
</plist>
