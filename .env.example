# Mindbase environment configuration

# API
MINDBASE_API_HOST=0.0.0.0
MINDBASE_API_PORT=8080
MINDBASE_API_KEY=change-me-to-a-long-random-secret

# Database
DATABASE_URL=postgresql+asyncpg://mindbase:mindbase@localhost:5432/mindbase

# Redis
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO locally, S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=mindbase
S3_REGION=us-east-1

# Embeddings (OpenAI-compatible API)
EMBEDDING_API_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# Worker
WORKER_BATCH_SIZE=10
WORKER_POLL_INTERVAL_MS=500

# MCP Server
MCP_SERVER_PORT=8090
MCP_SERVER_HOST=0.0.0.0
